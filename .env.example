# The Windows app connects to MongoDB running in WSL through localhost.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ecovoyage_ai
# Change before deployment; not needed for the local classroom demo.
JWT_SECRET=replace-with-a-long-random-secret
OPENWEATHER_API_KEY=
WAQI_TOKEN=
# Optional: set 5 or more to automatically refresh environment data while the server runs.
INGEST_INTERVAL_MINUTES=0
# Optional MongoDB Atlas Search support. With Atlas, replace MONGODB_URI above with your private mongodb+srv:// connection URI.
# Local MongoDB transparently uses field-search fallback.
USE_ATLAS_SEARCH=false
ATLAS_SEARCH_INDEX=destination-search
